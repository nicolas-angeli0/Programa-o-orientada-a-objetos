 package aula03.ex2;

public class Paciente {
    String nome;
    String telefone;

    public Paciente(String nome, String telefone){
        this.nome=nome;
        this.telefone=telefone;
    }
}


# principal

package aula03.ex2;

import java.time.LocalDate;

public class Principal {
    public static void main(String[] args){

        Paciente paciente1=new Paciente("Ana", "(11) 99999-1111");
        Consulta consulta1=new Consulta(paciente1, LocalDate.of(2026, 8, 20), 150.00);

        Paciente paciente2=new Paciente("Carlos", "(11) 99999-2222");
        Consulta consulta2=new Consulta(paciente2, LocalDate.of(2026, 8, 21), 180.00);

        consulta1.remarcar(LocalDate.of(2026, 8, 25));

        consulta1.exibirComprovante();
        consulta2.exibirComprovante();
    }
}
